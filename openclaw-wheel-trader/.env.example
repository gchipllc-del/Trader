# Alpaca API — Paper trading first
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Telegram notifications
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# OpenClaw (if using skill auth)
OPENCLAW_TOKEN=your_token_here

# --- LLM Analyst (pick ONE provider; config/wheel_strategy.yaml chooses which) ---
# DeepSeek — default LLM. Sign up at https://platform.deepseek.com (cheap: ~$0.14/1M tokens).
DEEPSEEK_API_KEY=your_deepseek_key_here

# Claude — fallback provider. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- News Sentiment (optional) ---
# NewsAPI.org (better coverage). Without it, falls back to Yahoo Finance RSS (free).
NEWSAPI_KEY=your_newsapi_key_here

# --- Market Data Providers (optional) ---
# Finnhub — earnings calendar (enforces "no options through earnings" rule),
#           analyst recs, company news, fundamentals. Free: 60 calls/min.
# https://finnhub.io/dashboard
FINNHUB_API_KEY=your_finnhub_key_here

# Alpha Vantage — macro indicators (GDP/CPI/unemployment), news sentiment.
# Free tier: 25 calls/day (heavily cached).
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
