<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.openclaw.caffeinate</string>
    <!--
        Keep the Mac awake so launchd jobs fire on schedule overnight.
        Previously invoked a bash wrapper that occasionally failed under
        launchd (pgrep + set -e + pipefail edge cases). Now invokes
        ``caffeinate -i`` directly with KeepAlive so launchd respawns it
        if it ever dies. No -t timeout — runs indefinitely. Result: the
        Mac stays awake while launchd is running this job.

        To pause: ``launchctl unload ~/Library/LaunchAgents/ai.openclaw.caffeinate.plist``
        To resume: ``launchctl load ~/Library/LaunchAgents/ai.openclaw.caffeinate.plist``
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <!-- Stronger flag set so launchd jobs fire 24/7:
             -i  prevent idle sleep
             -d  prevent display sleep
             -m  prevent disk sleep (otherwise disk spindown can
                 break long-running file-watch handles)
             -s  prevent system sleep WHILE ON AC POWER. This is the
                 critical flag — without it the system enters standby
                 after ~3h idle (pmset standbydelaylow).
             -u  declare user activity; resets idle timer (belt+suspenders)
             Note: -s only takes effect on AC. On battery the Mac
             will still sleep. Keep plugged in or run
             `sudo pmset -b sleep 0` separately for battery override. -->
        <string>-idmsu</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jesse/Desktop/projects/traderbot/openclaw-wheel-trader/logs/launchd_caffeinate.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jesse/Desktop/projects/traderbot/openclaw-wheel-trader/logs/launchd_caffeinate_err.log</string>
</dict>
</plist>
